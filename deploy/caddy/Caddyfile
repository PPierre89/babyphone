{
	email {$ACME_EMAIL}
	# Pas d'interface d'administration exposée.
	admin off
}

(securite) {
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Signalisation : seules les routes /ws et /healthz sont publiées.
{$SIGNALING_DOMAIN} {
	import securite

	@signaling path /ws /healthz
	handle @signaling {
		reverse_proxy signaling:8080
	}
	handle {
		respond 404
	}
}

# Notifications (ntfy). L'accès est refusé par défaut, un compte par téléphone.
{$PUSH_DOMAIN} {
	import securite
	reverse_proxy ntfy:8080
}
