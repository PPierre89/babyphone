# Copier en .env (jamais commité) et adapter.

# Version de l'image de signalisation (tag de release sans le « v »). Éviter "latest" :
# une mise à jour doit être un choix, pas une surprise.
SIGNALING_VERSION=0.1.0

# Noms de domaine pointant vers l'IP publique de la box (DNS ou DNS dynamique).
SIGNALING_DOMAIN=babyphone.example.fr
PUSH_DOMAIN=push.babyphone.example.fr
ACME_EMAIL=moi@example.fr

# Familles autorisées sur la signalisation, séparées par des virgules (8 à 64 caractères A-Z a-z 0-9 _ -).
# Générer un identifiant : openssl rand -hex 16
ALLOWED_FAMILIES=

# Phase 4 (profil "remote") : relais TURN.
# Générer le secret : openssl rand -base64 32
TURN_SECRET=
PUBLIC_IP=
